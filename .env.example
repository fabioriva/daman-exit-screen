# SvelteKit proxy target (embedded at build time: rebuild after changing it)
PUBLIC_API=http://127.0.0.1:3001/api/data

# HTTP server for the PLC API
API_PORT=3001

# Siemens PLC connection and polling
PLC_IP=192.168.24.2
PLC_RACK=0
PLC_SLOT=1
PLC_POLLING_MS=500

# Read 80 bytes (40 signed 16-bit values) from this DB and byte offset
PLC_DB_NUMBER=182
PLC_START=0

# SvelteKit production server
HOST=0.0.0.0
PORT=3000
